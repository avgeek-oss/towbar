{
  "name": "towbar-worker",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26 <27"
  },
  "description": "Temporal worker and isolated executor for Towbar.",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc --project tsconfig.build.json && pnpm bundle:workflows",
    "bundle:workflows": "node scripts/build-workflow-bundle.mjs",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --report-unused-disable-directives --deny-warnings",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --type-aware --report-unused-disable-directives --deny-warnings --fix",
    "start": "node dist/worker.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@smithy/node-http-handler": "4.12.1",
    "@temporalio/activity": "catalog:",
    "@temporalio/worker": "catalog:",
    "@temporalio/workflow": "catalog:",
    "@workspace/observability-node": "workspace:*",
    "@workspace/towbar-core": "workspace:*",
    "@workspace/towbar-deployer": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@temporalio/client": "catalog:",
    "@types/node": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
