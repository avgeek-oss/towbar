{
  "name": "towbar-api",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Towbar deployment control-plane API.",
  "homepage": "https://api.towbar.dev",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc --project tsconfig.build.json",
    "database:migrate:production": "node dist/cli/migrate.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts\"",
    "auth:recover-admin": "tsx src/cli/recover-admin.ts",
    "auth:reset-mfa": "tsx src/cli/reset-user-mfa.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@better-auth/api-key": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@noble/hashes": "2.4.0",
    "@temporalio/client": "catalog:",
    "@workspace/observability-node": "workspace:*",
    "@workspace/towbar-access": "workspace:*",
    "@workspace/towbar-core": "workspace:*",
    "@workspace/towbar-database": "workspace:*",
    "@workspace/towbar-email": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "catalog:",
    "hono": "4.13.12",
    "jose": "^6.2.12",
    "nodemailer": "10.2.1",
    "parse5": "8.0.1",
    "postgres": "catalog:",
    "ssh2": "1.17.0",
    "undici": "7.30.1",
    "ws": "8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@simplewebauthn/server": "13.3.2",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.2",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.2",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
