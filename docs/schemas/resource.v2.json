{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "access": {
      "type": "object",
      "properties": {
        "sshTunnel": {
          "type": "object",
          "properties": {
            "hostPort": { "type": "integer", "minimum": 1024, "maximum": 65535 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "autoDeploy": { "type": "boolean" },
    "backup": {
      "type": "object",
      "properties": {
        "integration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "gcs": {
          "type": "object",
          "properties": {
            "bucket": {
              "type": "string",
              "pattern": "^(?!\\d+\\.\\d+\\.\\d+\\.\\d+$)[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
            },
            "prefix": { "type": "string", "maxLength": 512 },
            "region": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "additionalProperties": false
        },
        "restoreFrom": { "type": "string", "enum": ["s3", "gcs"] },
        "retention": {
          "type": "object",
          "properties": {
            "keepLast": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "s3": {
          "type": "object",
          "properties": {
            "bucket": {
              "type": "string",
              "pattern": "^(?!\\d+\\.\\d+\\.\\d+\\.\\d+$)[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
            },
            "encryption": { "type": "string", "enum": ["AES256", "aws:kms"] },
            "kmsKeyId": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "prefix": { "type": "string", "maxLength": 512 },
            "region": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "additionalProperties": false
        },
        "schedule": {
          "type": "object",
          "properties": {
            "cron": { "type": "string", "minLength": 1, "maxLength": 120 },
            "timezone": { "type": "string", "const": "UTC" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "notifications": {
      "type": "object",
      "properties": {
        "email": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deployments": { "type": "boolean" },
              "deploymentFailures": { "type": "boolean" },
              "backupsAndRestores": { "type": "boolean" },
              "alertsAndIncidents": { "type": "boolean" },
              "address": {
                "type": "string",
                "maxLength": 320,
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "required": [
              "deployments",
              "backupsAndRestores",
              "alertsAndIncidents",
              "address"
            ],
            "additionalProperties": false
          }
        },
        "slack": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deployments": { "type": "boolean" },
              "deploymentFailures": { "type": "boolean" },
              "backupsAndRestores": { "type": "boolean" },
              "alertsAndIncidents": { "type": "boolean" },
              "channelId": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]{1,79}$"
              }
            },
            "required": [
              "deployments",
              "backupsAndRestores",
              "alertsAndIncidents",
              "channelId"
            ],
            "additionalProperties": false
          }
        },
        "discord": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deployments": { "type": "boolean" },
              "deploymentFailures": { "type": "boolean" },
              "backupsAndRestores": { "type": "boolean" },
              "alertsAndIncidents": { "type": "boolean" },
              "webhookId": { "type": "string", "pattern": "^\\d{1,20}$" }
            },
            "required": [
              "deployments",
              "backupsAndRestores",
              "alertsAndIncidents",
              "webhookId"
            ],
            "additionalProperties": false
          }
        },
        "telegram": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deployments": { "type": "boolean" },
              "deploymentFailures": { "type": "boolean" },
              "backupsAndRestores": { "type": "boolean" },
              "alertsAndIncidents": { "type": "boolean" },
              "chatId": { "type": "string", "pattern": "^-?\\d{1,20}$" },
              "messageThreadId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 2147483647
              }
            },
            "required": [
              "deployments",
              "backupsAndRestores",
              "alertsAndIncidents",
              "chatId"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "externalSecrets": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "integration": { "type": "string", "const": "infisical" },
            "project": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "environmentSlug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "secretPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": ["integration", "project"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "integration": { "type": "string", "const": "doppler" },
            "project": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "config": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "required": ["integration", "project"],
          "additionalProperties": false
        }
      ]
    },
    "ingress": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "type": { "type": "string", "const": "proxy" } },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "cloudflare-tunnel" },
            "integration": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "tunnel": { "type": "string", "minLength": 1, "maxLength": 128 },
            "access": { "default": false, "type": "boolean" }
          },
          "required": ["type", "integration"],
          "additionalProperties": false
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
