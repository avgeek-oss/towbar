{
  "name": "@workspace/towbar-deployer",
  "description": "Isolated SSH, Docker, and Caddy deployment executor for Towbar.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --report-unused-disable-directives --deny-warnings",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --type-aware --report-unused-disable-directives --deny-warnings --fix",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/towbar-core": "workspace:*",
    "undici": "7.30.1",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
