{
  "name": "@workspace/towbar-core",
  "description": "Towbar manifest, reconciliation, deployment, and workflow contracts.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./date-time": "./dist/date-time.js",
    "./date-time-range": "./dist/date-time-range.js",
    ".": "./dist/index.js",
    "./manifest": "./dist/manifest.js",
    "./network-policy": "./dist/network-policy.js",
    "./preview": "./dist/preview.js",
    "./reconciliation": "./dist/reconciliation.js",
    "./request-signing": "./dist/request-signing.js",
    "./resource-operations": "./dist/resource-operations.js",
    "./security": "./dist/security.js",
    "./temporal": "./dist/temporal.js",
    "./schema": "./schemas/repository.v2.json",
    "./scout-alerts": "./dist/scout-alerts.js",
    "./deployment-comparison": "./dist/deployment-comparison.js",
    "./inventory": "./dist/inventory.js",
    "./schema/app": "./schemas/app.v2.json",
    "./schema/compose": "./schemas/compose.v2.json",
    "./schema/resource": "./schemas/resource.v2.json",
    "./analytics": "./dist/analytics.js",
    "./repository-identity": "./dist/repository-identity.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --report-unused-disable-directives --deny-warnings",
    "test": "pnpm schemas:check && tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "schemas": "tsx scripts/export-manifest-schemas.ts",
    "schemas:check": "tsx scripts/export-manifest-schemas.ts --check"
  },
  "dependencies": {
    "minimatch": "10.2.6",
    "yaml": "catalog:",
    "zod": "catalog:",
    "@workspace/towbar-contracts": "workspace:*",
    "croner": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
