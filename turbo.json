{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tools/oxlint/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "TOWBAR_*",
        "DATABASE_TOWBAR_*",
        "TEMPORAL_*",
        "DEMO_*",
        "WORKER_HEALTH_PORT",
        "NEXT_PUBLIC_*",
        "SOURCE_COMMIT",
        "PATH"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "TOWBAR_*",
        "DATABASE_TOWBAR_*",
        "TEMPORAL_*",
        "DEMO_*",
        "WORKER_HEALTH_PORT",
        "NEXT_PUBLIC_*",
        "SOURCE_COMMIT"
      ]
    },
    "dev:worker": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "TOWBAR_*",
        "DATABASE_TOWBAR_*",
        "TEMPORAL_*",
        "DEMO_*",
        "WORKER_HEALTH_PORT",
        "NEXT_PUBLIC_*",
        "SOURCE_COMMIT"
      ]
    },
    "towbar-web-app#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "SOURCE_COMMIT",
        "NEXT_PUBLIC_TOWBAR_APP_BASE_URL",
        "NEXT_PUBLIC_TOWBAR_PUBLIC_DEMO",
        "TOWBAR_APP_BASE_URL"
      ],
      "passThroughEnv": ["NEXT_TELEMETRY_DISABLED"]
    }
  },
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["AGENT_*", "ANTHROPIC_API_KEY"]
}
